# shortest_path

# 플로이드 워셜: 모든 노드에서 다른 모든 노드까지의 최단 경로 모두 계산(distance: 2차원 테이블)
# D_ab = min(D_ab, D_ak + D_kb)
# 시간복잡도: O(N**3) 그러므로 N의 크기가 약 500정도일 때만 사용 가능

INF = int(1e9)
n, m = map(int, input().split())

graph = [[INF] * (n + 1) for _ in range(n + 1)]

for a in range(1, n + 1):
    for b in range(1, n + 1):
        if a == b:
            graph[a][b] = 0

for _ in range(m):
    a, b, c = map(int, input().split())
    graph[a][b] = c

for k in range(1, n + 1):
    for a in range(1, n + 1):
        for b in range(1, n + 1):
            graph[a][b] = min(graph[a][b], graph[a][k] + graph[k][b])

for a in range(1, n + 1):
    for b in range(1, n + 1):
        if graph[a][b] == INF:
            print("INFINITY", end=" ")
        else:
            print(graph[a][b], end =" ")
    print()
