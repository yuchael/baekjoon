# BFS
from collections import deque

def bfs(n, graph, start):
    q = deque([start])
    visited = [False] * (n + 1)
    visited[start] = True

    while q:
        now = q.popleft()

        for nxt in graph[now]:
            if not visited[nxt]:
                visited[nxt] = True
                q.append(nxt)

# 미로 탈출: N x M 격자 미로에서 1로 된 길을 따라 (N, M)에 가장 빠르게 도착할 수 있는 거리(비용 같을 때 최단거리 구하기 문제)
from collections import deque

def solution(n, m, graph):
    dx = [-1, 1, 0, 0]
    dy = [0, 0, -1, 1]
    
    q = deque([(0, 0)])

    while q:
        x, y = q.popleft()

        for i in range(4):
            nx = x + dx[i]
            ny = y + dy[i]

            if 0 <= nx < n and 0 <= ny < m:
                if graph[nx][ny] == 1:
                    graph[nx][ny] = graph[x][y] + 1
                    q.append((nx, ny))

    return graph[n - 1][m - 1]
