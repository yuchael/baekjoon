# DP

# 개미 전사: 일직선의 식량창고 몰래 공격할 때, 들키지 않고 최대한 많이 약탈하기(인접한 식량창고에서 공격 사실을 알 수 있음, 식량 창고마다 식량 개수 다름)
# {1, 3, 1, 5}일 때 최대 8

def solution(arr):

    n = len(arr)
    dp = [0] * n

    dp[0] = arr[0]
    dp[1] = max(arr[0], arr[1])

    for i in range(2, n):
        dp[i] = max(arr[i] + dp[i - 2], dp[i - 1])   

    return dp[n - 1]

print(solution([1, 3, 1, 5]))
